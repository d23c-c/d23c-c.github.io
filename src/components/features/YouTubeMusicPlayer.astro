---
const videoId = "AnS96xdZ_7o";
---
<section id="personal-youtube-player" class="youtube-music card-base" aria-label="Music player" hidden>
 <header>
  <div><span class="player-label">NOW PLAYING</span><h2>Hardest To Love</h2><p>The Weeknd · After Hours</p></div>
  <button type="button" data-youtube-music-close aria-label="Close music player" class="btn-plain rounded-lg h-10 w-10">✕</button>
 </header>
 <iframe data-video-id={videoId} title="The Weeknd — Hardest To Love (Official Audio)" width="560" height="315" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
 <a href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener noreferrer">Open on YouTube ↗</a>
</section>
<style>
 .youtube-music { position:fixed; z-index:150; right:1.5rem; bottom:1.5rem; width:min(24rem,calc(100vw - 2rem)); padding:1.1rem; border:1px solid color-mix(in srgb,var(--primary) 25%,transparent); box-shadow:0 16px 64px #0006; border-radius:1.25rem; }
 .youtube-music[hidden] { display:none !important; }
 header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; gap:.5rem; }
 h2 { font-size:1.15rem; font-weight:700; margin:.25rem 0; }
 p { font-size:.85rem; opacity:.65; }
 .player-label { color:var(--primary); font-size:.65rem; letter-spacing:.16em; font-weight:700; }
 iframe { display:block; width:100%; height:auto; aspect-ratio:16/9; border:0; border-radius:.8rem; background:#080808; }
 a { display:inline-block; color:var(--primary); font-size:.8rem; margin-top:.8rem; }
 @media(max-width:640px) { .youtube-music { right:1rem; bottom:1rem; } }
</style>
<script is:inline data-swup-ignore-script>
 (() => {
 if (window.__personalMusicInitialized) return;
 window.__personalMusicInitialized = true;
 const panel = document.getElementById('personal-youtube-player');
 const frame = panel?.querySelector('iframe');
 const closeButton = panel?.querySelector('[data-youtube-music-close]');
 let lastTrigger = null;
 const syncTriggers = (open) => document.querySelectorAll('[data-youtube-music-trigger]').forEach(button => button.setAttribute('aria-expanded', String(open)));
 const close = () => {
  if (!panel || !frame) return;
  panel.hidden = true;
  frame.removeAttribute('src');
  syncTriggers(false);
  if (lastTrigger?.isConnected) lastTrigger.focus({preventScroll:true});
 };
 document.addEventListener('click', event => {
  if (!(event.target instanceof Element) || !panel || !frame) return;
  const trigger = event.target.closest('[data-youtube-music-trigger]');
  if (trigger) {
   if (!panel.hidden) { close(); return; }
   lastTrigger = trigger;
   const embed = new URL(`https://www.youtube.com/embed/${frame.dataset.videoId}`);
   embed.search = new URLSearchParams({autoplay:'1', hl:'en', playsinline:'1', rel:'0', origin:location.origin, widget_referrer:location.href}).toString();
   frame.src = embed.href;
   panel.hidden = false;
   syncTriggers(true);
   closeButton?.focus({preventScroll:true});
  } else if (event.target.closest('[data-youtube-music-close]')) close();
 });
 document.addEventListener('keydown', event => { if (event.key === 'Escape' && panel && !panel.hidden) close(); });
 document.addEventListener('swup:contentReplaced', () => syncTriggers(!!panel && !panel.hidden));
 const connect = () => window.swup?.hooks?.on('page:view', () => syncTriggers(!!panel && !panel.hidden));
 if (window.swup?.hooks) connect(); else document.addEventListener('swup:enable', connect, {once:true});
 })();
</script>
