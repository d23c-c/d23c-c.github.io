---
import { learningTracks, studyPeriod } from "@/data/learning";
import { getSortedPostsList } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";
const notes = (await getSortedPostsList()).filter(p=>p.id.startsWith("learning-notes/"));
const years = [...new Set(learningTracks.map(t=>t.from.slice(0,4)))].sort().reverse();
---
<section id="learning-study-timeline" class="card-base p-6 md:p-9" data-pagefind-body>
 <h2 class="text-3xl font-bold mb-3">Learning Timeline</h2>
 <p class="text-sm text-75 mb-8">Study periods estimated from school semesters. Note publication dates are separate.</p>
 {years.map(year=><details open class="mb-8"><summary class="text-2xl font-bold text-(--primary) cursor-pointer mb-5">{year}</summary>
  <div class="ml-3 border-l-2 border-(--primary)/25 pl-6 space-y-6">{learningTracks.filter(t=>t.from.startsWith(year)).sort((a,b)=>b.from.localeCompare(a.from)).map(track=>{
   const units=notes.filter(p=>p.id.startsWith(`learning-notes/${track.slug}/`)).sort((a,b)=>(a.data.seriesOrder??0)-(b.data.seriesOrder??0));
   return <article class="relative"><span class="absolute -left-[2rem] top-2 h-3 w-3 rounded-full bg-(--primary)" aria-hidden="true"></span>
    <a href={url(`/learning-notes/${track.slug}/`)} class="text-xl font-bold hover:text-(--primary)">{track.name}</a><p class="text-sm text-(--primary) mt-1">{studyPeriod(track)}</p><p class="text-sm text-50 mt-1">{track.stage}</p>
    <details class="mt-3"><summary class="cursor-pointer text-sm text-75">{units.length} learning notes</summary><ol class="grid gap-2 mt-3">{units.map(post=><li><a class="text-sm hover:text-(--primary)" href={getPostUrlBySlug(post.id)}>{post.data.title}</a></li>)}</ol></details>
   </article>;
  })}</div>
 </details>)}
</section>
