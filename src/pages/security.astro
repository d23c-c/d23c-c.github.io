---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
const labs = [
 { name:"Next-Generation Information Security | NGIS Lab", code:"NGIS", topics:["Active Directory (AD)", "Cyber Threat Intelligence (CTI)", "Lateral Movement"] },
 { name:"Agentic Red Team Operations | MIRAGE Lab", code:"MIRAGE", topics:["Network Attack & Defense", "Forensics"] },
];
const description = "An autonomous LLM agent focused on host-side anti-forensic behavior, with capabilities for environment awareness, technique selection, execution and adaptive adjustment. It assesses the defensive environment, chooses between Stealth and Impairment strategies, and adjusts subsequent actions based on execution results without human intervention. Its central evaluation metric is post-incident forensic reconstructability: how much of the residual artifact trail a DFIR team can reconstruct after the agent completes its task. The research also aims to produce adversarial insights that help blue teams strengthen detection and forensic workflows.";
---
<MainGridLayout title="Lab" description="NGIS Lab, MIRAGE Lab and research projects.">
 <section class="card-base p-6 md:p-9" data-pagefind-body>
  <h2 class="text-3xl font-bold mb-8">Lab</h2>
  <div class="grid gap-5 xl:grid-cols-2">
   {labs.map(lab => <article class="lab-card rounded-xl border border-black/10 dark:border-white/10 p-6">
    <span class="text-sm text-(--primary) tracking-widest">{lab.code}</span>
    <h3 class="text-xl font-bold mt-3 mb-5 leading-relaxed">{lab.name}</h3>
    <ul class="flex flex-wrap gap-2">{lab.topics.map(topic => <li class="rounded-lg bg-(--primary)/10 text-(--primary) px-3 py-2 text-sm">{topic}</li>)}</ul>
   </article>)}
  </div>
  <section class="mt-10 border-t border-black/10 dark:border-white/10 pt-8" aria-labelledby="research-projects">
   <h3 id="research-projects" class="text-xl font-bold mb-5">Research Projects</h3>
   <article class="rounded-xl border border-(--primary)/30 bg-(--primary)/5 p-6 md:p-8">
    <div class="flex flex-wrap items-center gap-3 mb-5"><h4 class="text-3xl font-bold">h1d3&amp;C</h4><span class="rounded-full bg-(--primary)/15 text-(--primary) px-3 py-1 text-xs">In preparation</span></div>
    <p class="leading-loose text-75">{description}</p>
    <ul aria-label="Research tags" class="mt-6 flex flex-wrap gap-2">
     {["LLM", "autonomous-agent", "anti-forensics", "DFIR", "Stealth", "Impairment"].map(tag => <li class="text-sm text-(--primary)">#{tag}</li>)}
    </ul>
   </article>
  </section>
 </section>
</MainGridLayout>
